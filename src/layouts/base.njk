<!DOCTYPE html>
<html lang="{{ pageLang | default('en') }}" class="">
<head>
  {% include "partials/head.njk" %}
</head>
<body class="min-h-screen flex flex-col">
  {#
    Theme init. Runs before the first paint, so neither the colours nor the
    toggle's icon flash the wrong state. Three modes: an absent `theme` key
    means "follow the system", which is the default for a first-time visitor.
  #}
  <script>
    (function () {
      var mode = 'system';
      try { mode = localStorage.getItem('theme') || 'system'; } catch (e) { /* private mode */ }
      if (mode !== 'light' && mode !== 'dark') mode = 'system';
      var dark = mode === 'dark' ||
        (mode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('dark', dark);
      document.documentElement.dataset.themeMode = mode;
    })();
  </script>

  <!-- Skip to content -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-100 focus:px-4 focus:py-2 focus:bg-amber-400 focus:text-navy-900 focus:rounded-lg focus:font-semibold">
    {{ skipToContentLabel | default("Skip to content") }}
  </a>

  {% include "partials/header.njk" %}

  <main id="main-content" class="flex-1">
    {% block content %}{% endblock %}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/scripts.njk" %}
</body>
</html>
