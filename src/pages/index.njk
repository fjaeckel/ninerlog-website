{% set pageTitle = "NinerLog — Free Open-Source Pilot Logbook (EASA/FAA, No Subscription)" %}
{% set pageDescription = "Free, open-source pilot logbook for GA pilots. Log flights, track currency, manage licenses. EASA & FAA compliant. No subscriptions." %}
{% set pagePath = "/" %}
{% set altDe = "/de/flugbuch" %}
{% set sitemapChangefreq = "weekly" %}
{% set sitemapPriority = "1.0" %}
{% extends "layouts/base.njk" %}

{% block content %}

<!-- ============================================================
     HERO SECTION — Runway perspective + horizon glow
     ============================================================ -->
<section class="relative bg-linear-to-br from-navy-900 via-navy-800 to-navy-950 py-20 lg:py-36 overflow-hidden">
  <!-- Runway perspective lines -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <svg class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] lg:w-[1200px] lg:h-[600px] opacity-[0.04]" viewBox="0 0 1200 600" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Runway edges converging to vanishing point -->
      <line x1="600" y1="0" x2="200" y2="600" stroke="white" stroke-width="1.5"/>
      <line x1="600" y1="0" x2="1000" y2="600" stroke="white" stroke-width="1.5"/>
      <!-- Centerline dashes -->
      <line x1="600" y1="40" x2="540" y2="160" stroke="white" stroke-width="2" stroke-dasharray="20 12"/>
      <line x1="540" y1="160" x2="460" y2="320" stroke="white" stroke-width="2.5" stroke-dasharray="24 14"/>
      <line x1="460" y1="320" x2="370" y2="500" stroke="white" stroke-width="3" stroke-dasharray="28 16"/>
      <line x1="600" y1="40" x2="660" y2="160" stroke="white" stroke-width="2" stroke-dasharray="20 12"/>
      <line x1="660" y1="160" x2="740" y2="320" stroke="white" stroke-width="2.5" stroke-dasharray="24 14"/>
      <line x1="740" y1="320" x2="830" y2="500" stroke="white" stroke-width="3" stroke-dasharray="28 16"/>
      <!-- Threshold markings -->
      <rect x="300" y="560" width="60" height="8" fill="white" opacity="0.6"/>
      <rect x="380" y="560" width="60" height="8" fill="white" opacity="0.6"/>
      <rect x="460" y="560" width="60" height="8" fill="white" opacity="0.6"/>
      <rect x="680" y="560" width="60" height="8" fill="white" opacity="0.6"/>
      <rect x="760" y="560" width="60" height="8" fill="white" opacity="0.6"/>
      <rect x="840" y="560" width="60" height="8" fill="white" opacity="0.6"/>
      <!-- Horizon glow -->
      <ellipse cx="600" cy="0" rx="500" ry="40" fill="url(#horizonGlow)"/>
      <defs>
        <radialGradient id="horizonGlow" cx="50%" cy="50%">
          <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.15"/>
          <stop offset="100%" stop-color="#38bdf8" stop-opacity="0"/>
        </radialGradient>
      </defs>
    </svg>
  </div>
  <!-- Topographic contour overlay -->
  <div class="absolute inset-0 bg-topo-pattern pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto px-4 text-center relative z-10">
    <!-- Squawk-style status badge -->
    <div class="mb-6 reveal">
      <span class="freq-badge">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-blink"></span>
        OPEN SOURCE &bull; FREE FOREVER
      </span>
    </div>

    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white text-balance reveal reveal-delay-1">
      Your Logbook. Your Data.<br class="hidden sm:block" />
      Forever Free.
    </h1>
    <p class="mt-6 text-lg lg:text-xl text-slate-300 leading-relaxed max-w-2xl mx-auto reveal reveal-delay-2">
      The open-source pilot logbook trusted by GA pilots worldwide. Log flights, track currency, manage licenses &mdash; all for free. No subscriptions, no limits, no catch.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 reveal reveal-delay-3">
      <a href="https://app.ninerlog.com/register"
         class="inline-flex items-center gap-2 px-8 py-4
                bg-linear-to-r from-amber-400 to-amber-500
                text-navy-900 font-semibold text-lg
                rounded-full
                shadow-lg shadow-amber-400/30
                hover:shadow-xl hover:shadow-amber-400/40 hover:scale-[1.02]
                active:scale-[0.98]
                transition-all duration-200
                focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 focus-visible:ring-offset-navy-900
                w-full sm:w-auto justify-center">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
        Start Logging &mdash; It&rsquo;s Free
      </a>
      <a href="/features"
         class="inline-flex items-center gap-2 px-6 py-3
                border border-white/20 text-white
                rounded-full
                hover:bg-white/10 hover:border-white/30
                transition-all duration-200
                focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-white/50
                w-full sm:w-auto justify-center">
        See All Features &rarr;
      </a>
    </div>
    <p class="mt-6 text-sm text-slate-400 reveal reveal-delay-4">
      Community-driven. Open source on GitHub.
    </p>
  </div>

  <!-- Horizon line at bottom -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-sky-500/20 to-transparent" aria-hidden="true"></div>
</section>

<!-- ============================================================
     TRUST BAR
     ============================================================ -->
<section class="relative bg-sky-500/10 border-y border-sky-500/20">
  <div class="max-w-6xl mx-auto px-4 py-4 flex flex-wrap justify-center gap-8 lg:gap-14">
    <div class="flex items-center gap-2.5 text-sm font-medium text-sky-100 uppercase tracking-wider reveal">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
      Open Source
    </div>
    <div class="flex items-center gap-2.5 text-sm font-medium text-sky-100 uppercase tracking-wider reveal reveal-delay-1">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
      Free Forever
    </div>
    <div class="flex items-center gap-2.5 text-sm font-medium text-sky-100 uppercase tracking-wider reveal reveal-delay-2">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      Community-Driven
    </div>
  </div>
</section>

<!-- ============================================================
     FEATURES GRID
     ============================================================ -->
<section class="bg-white dark:bg-navy-950 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl lg:text-4xl font-bold tracking-tight text-slate-800 dark:text-white reveal">
        Everything you need.<br />Nothing you don&rsquo;t.
      </h2>
      <p class="mt-4 text-lg text-slate-500 dark:text-slate-400 max-w-2xl mx-auto reveal reveal-delay-1">
        A modern pilot logbook built for the way you fly. Every feature free, forever.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      <!-- Open Source -->
      <div class="group p-6 bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl hover:shadow-lg hover:-translate-y-1 transition-all duration-200 reveal reveal-delay-1">
        <div class="w-12 h-12 rounded-lg bg-slate-500/10 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-slate-800 dark:text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Open Source</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">See the code. Host it yourself. No vendor lock-in. Ever.</p>
      </div>

      <!-- Flight Logging -->
      <div class="group p-6 bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl hover:shadow-lg hover:-translate-y-1 transition-all duration-200 reveal reveal-delay-1">
        <div class="w-12 h-12 rounded-lg bg-sky-500/10 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-sky-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Flight Logging</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">Log every detail, from block times to IFR approaches. Quick entry templates turn logging into a 30-second habit.</p>
      </div>

      <!-- Quick Log -->
      <div class="group p-6 bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl hover:shadow-lg hover:-translate-y-1 transition-all duration-200 reveal reveal-delay-2">
        <div class="w-12 h-12 rounded-lg bg-sky-500/10 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-sky-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M9 2h6"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Quick Log <span class="ml-1 align-middle text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">New</span></h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">Tap off block, takeoff, landing, on block &mdash; the flight logs itself, block times and all, works offline.</p>
      </div>

      <!-- Powerful Search -->
      <div class="group p-6 bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl hover:shadow-lg hover:-translate-y-1 transition-all duration-200 reveal reveal-delay-2">
        <div class="w-12 h-12 rounded-lg bg-violet-500/10 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-violet-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Powerful Search <span class="ml-1 align-middle text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">New</span></h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">One box searches registration, type, ICAO, and remarks at once. Find any flight in seconds.</p>
      </div>

      <!-- Multi-License -->
      <div class="group p-6 bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl hover:shadow-lg hover:-translate-y-1 transition-all duration-200 reveal reveal-delay-2">
        <div class="w-12 h-12 rounded-lg bg-amber-500/10 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Multi-License</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">PPL, SPL, CPL across EASA, FAA, and any authority worldwide. All in one logbook.</p>
      </div>

      <!-- Currency Tracking -->
      <div class="group p-6 bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl hover:shadow-lg hover:-translate-y-1 transition-all duration-200 reveal reveal-delay-3">
        <div class="w-12 h-12 rounded-lg bg-emerald-500/10 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Currency Tracking</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">Automatic 90-day recency, revalidation rules, FAA 61.57. Never guess if you&rsquo;re current.</p>
      </div>

      <!-- Instructor Signing -->
      <div class="group p-6 bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl hover:shadow-lg hover:-translate-y-1 transition-all duration-200 reveal reveal-delay-3">
        <div class="w-12 h-12 rounded-lg bg-rose-500/10 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Instructor Signing <span class="ml-1 align-middle text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">New</span></h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">Sign in person or send a secure link. Signed flights lock &mdash; your training record stays as endorsed.</p>
      </div>

      <!-- Credentials & Medicals -->
      <div class="group p-6 bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl hover:shadow-lg hover:-translate-y-1 transition-all duration-200 reveal reveal-delay-4">
        <div class="w-12 h-12 rounded-lg bg-rose-500/10 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Credentials &amp; Medicals</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">Track expiry dates for medicals, ratings, and credentials. Get warned before they lapse.</p>
      </div>

      <!-- Language Support -->
      <div class="group p-6 bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl hover:shadow-lg hover:-translate-y-1 transition-all duration-200 reveal reveal-delay-5">
        <div class="w-12 h-12 rounded-lg bg-sky-500/10 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-sky-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Language Support</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">Full German support today, with more languages coming. Use NinerLog in the language you prefer.</p>
      </div>

      <!-- Reports & Maps -->
      <div class="group p-6 bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl hover:shadow-lg hover:-translate-y-1 transition-all duration-200 reveal reveal-delay-6">
        <div class="w-12 h-12 rounded-lg bg-violet-500/10 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-violet-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Reports &amp; Maps</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">Charts, route maps, airport heatmaps, PDF logbook export. See your flying career at a glance.</p>
      </div>

      <!-- Import & Export -->
      <div class="group p-6 bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl hover:shadow-lg hover:-translate-y-1 transition-all duration-200 reveal reveal-delay-7">
        <div class="w-12 h-12 rounded-lg bg-cyan-500/10 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-cyan-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Import &amp; Export</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">Bring your data in. Take it out anytime. CSV, ForeFlight, PDF &mdash; your data is never trapped.</p>
      </div>

      <!-- Cloud Backup -->
      <div class="group p-6 bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl hover:shadow-lg hover:-translate-y-1 transition-all duration-200 reveal reveal-delay-8">
        <div class="w-12 h-12 rounded-lg bg-emerald-500/10 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.5 19a4.5 4.5 0 0 0 .5-8.96A6 6 0 0 0 6.34 9.1 4.5 4.5 0 0 0 7 18h2"/><path d="M12 12v7"/><path d="m9 15 3-3 3 3"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Cloud Backup <span class="ml-1 align-middle text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">New</span></h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">Automatic offsite backups to a destination <em>you</em> own &mdash; any S3-compatible bucket, SFTP server, or WebDAV share. Your storage, your keys.</p>
      </div>

      <!-- Flying Club Ready (self-hosted) -->
      <div class="group p-6 bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl hover:shadow-lg hover:-translate-y-1 transition-all duration-200 reveal reveal-delay-8">
        <div class="w-12 h-12 rounded-lg bg-amber-500/10 flex items-center justify-center mb-4">
