    <h1>Datenschutzerkl&auml;rung</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400">Stand: Juli 2026</p>

    <h2>1. Verantwortlicher</h2>
    <p>
      {% set addressCountry = "Deutschland" %}{% include "partials/legal-address.njk" %}<br />
      E-Mail: <a href="mailto:hej@ninerlog.com">hej@ninerlog.com</a>
