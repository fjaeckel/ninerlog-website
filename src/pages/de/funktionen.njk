        { "cat": "Flotte", "items": ["Luftfahrzeugverwaltung", "Anbindung ans Bordbuch"] },
        { "cat": "Suche", "items": ["Leistungsstarke Flugsuche", "Filter über mehrere Felder", "Eigene Sortierung"] },
        { "cat": "Ausbildung", "items": ["Fluglehrer-Unterschrift", "Vor Ort oder aus der Ferne", "Gesperrte Einträge nach Signatur"] },
        { "cat": "Daten", "items": ["Import (CSV/XLS/ForeFlight)", "Export (CSV/PDF/JSON)", "Externes Cloud-Backup"] },
        { "cat": "Auswertung", "items": ["Berichte & Diagramme", "Routenkarten", "Flugplatz-Heatmap"] },
        { "cat": "Fortgeschritten", "items": ["Instrumentenzeiten", "Personen & Crew", "Automatische Berechnungen"] },
        { "cat": "Sicherheit", "items": ["Anmeldung per Passkey", "Zwei-Faktor-Auth (TOTP)", "Wiederherstellungscodes"] },
        { "cat": "Vereinsbetrieb", "items": ["Admin-Panel", "Benutzerverwaltung", "Mitteilungen"] },
        { "cat": "Plattform", "items": ["Selbst hosten", "Sicherheitsgehärtet", "MIT-Lizenz"] }
      ] %}
      {% for group in features %}
      <div class="p-6 bg-white dark:bg-navy-800 rounded-xl reveal reveal-delay-{{ loop.index }}">
        <h3 class="text-sm font-bold text-sky-500 uppercase tracking-wider mb-3">{{ group.cat }}</h3>
        <ul class="space-y-2">
          {% for item in group.items %}
          <li class="flex items-start gap-2 text-sm text-slate-600 dark:text-slate-300">
            <svg class="w-4 h-4 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            {{ item }}
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

