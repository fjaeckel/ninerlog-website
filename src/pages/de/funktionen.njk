{% set pageLang = "de" %}
{% set pageTitle = "Funktionen — NinerLog" %}
{% set pageDescription = "Quick Log, eigene Recency-Regeln, vollständige Logbuch-Auswertung, zwölf Importformate, unterschreibbares PDF-Logbuch, Backups auf deinem eigenen Speicher. Open Source und kostenlos nutzbar." %}
{% set pagePath = "/de/funktionen" %}
{% set altEn = "/features" %}
{% set sitemapChangefreq = "monthly" %}
{% set sitemapPriority = "0.9" %}
{% set skipToContentLabel = "Zum Inhalt springen" %}
{% extends "layouts/base.njk" %}

{% block content %}

{# Wiederkehrende Listen- und Kartenformen. Einmal definiert, damit ein
   Abschnitt nach seinem Inhalt aussieht und nicht nach vierzig Zeilen SVG. #}
{% macro check(text, isNew) %}
<li class="flex items-start gap-3">
  <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
  <span class="text-slate-600 dark:text-slate-300">{{ text | safe }}{% if isNew %} <span class="ml-0.5 align-middle text-[10px] font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">Neu</span>{% endif %}</span>
</li>
{% endmacro %}

{% macro card(title, body, isNew) %}
<div class="p-6 bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
  <h3 class="text-base font-semibold text-slate-800 dark:text-white mb-2">
    {{ title | safe }}{% if isNew %} <span class="ml-1 align-middle text-[10px] font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">Neu</span>{% endif %}
  </h3>
  <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{{ body | safe }}</p>
</div>
{% endmacro %}

{# `dot` bekommt eine vollständige Klasse, kein Farbfragment: Tailwind liest
   diese Datei als Text und sieht zusammengesetzte Klassen nie. #}
{% macro badge(text, dot) %}
<span class="freq-badge mb-4">
  <span class="inline-block w-1.5 h-1.5 rounded-full {{ dot | default('bg-emerald-400') }} animate-blink"></span>
  {{ text | safe }}
</span>
{% endmacro %}

<!-- ============================================================
     HERO — bewusst ohne Call-to-Action. Diese Seite ist zum Lesen da.
     ============================================================ -->
<section class="relative bg-navy-900 bg-linear-to-br from-navy-900 via-navy-800 to-navy-950 py-16 lg:py-24 overflow-hidden">
  <div class="absolute inset-0 bg-topo-pattern pointer-events-none" aria-hidden="true"></div>
  <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
    <div class="mb-4 reveal">
      <span class="freq-badge">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-blink"></span>
        OPEN SOURCE &bull; KOSTENLOS NUTZBAR
      </span>
    </div>
    <h1 class="text-4xl lg:text-5xl font-extrabold tracking-tight text-white text-balance reveal reveal-delay-1">
      Ein Flugbuch, das den<br class="hidden sm:block" /> Papierkram erledigt.
    </h1>
    <p class="mt-6 text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto reveal reveal-delay-2">
      Nachtzeit aus dem tatsächlichen Sonnenuntergang an deinem Zielflugplatz. Recency-Regeln, die du selbst schreibst. Ein PDF-Logbuch, das dein Fluglehrer Seite für Seite unterschreiben kann. Hier steht alles, was NinerLog kann &mdash; lass dir Zeit.
    </p>
  </div>
  <div class="absolute bottom-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-sky-500/20 to-transparent" aria-hidden="true"></div>
</section>

<!-- ============================================================
     KAPITELNAVIGATION — die Seite ist absichtlich lang, das macht sie lesbar
     ============================================================ -->
<nav class="bg-slate-50 dark:bg-navy-900 border-b border-slate-200 dark:border-navy-800" aria-label="Funktionsbereiche">
  {# Am Handy eine scrollende Zeile — dreizehn umgebrochene Pillen füllen sonst
     den Bildschirm; ab sm umgebrochen und zentriert. #}
  <div class="max-w-6xl mx-auto px-4 py-4 flex gap-2 overflow-x-auto sm:flex-wrap sm:justify-center">
    {% set chapters = [
      { href: "#erfassen", label: "Erfassen" },
      { href: "#suche", label: "Suche" },
      { href: "#recency", label: "Recency" },
      { href: "#nachweise", label: "Nachweise" },
      { href: "#auswertung", label: "Auswertung" },
      { href: "#flotte", label: "Flotte" },
      { href: "#unterschrift", label: "Unterschrift" },
      { href: "#import", label: "Import" },
      { href: "#export", label: "Export" },
      { href: "#backup", label: "Backup" },
      { href: "#sicherheit", label: "Sicherheit" },
      { href: "#verein", label: "Verein" },
      { href: "#ueberall", label: "Überall" }
    ] %}
    {% for c in chapters %}
    <a href="{{ c.href }}"
       class="shrink-0 whitespace-nowrap px-3 py-1.5 text-sm rounded-full border border-slate-300 dark:border-navy-700 text-slate-600 dark:text-slate-300
              hover:border-sky-500 hover:text-sky-600 dark:hover:text-sky-400 transition-colors">{{ c.label }}</a>
    {% endfor %}
  </div>
</nav>

<!-- ============================================================
     1 — ERFASSEN
     ============================================================ -->
<section id="erfassen" class="scroll-mt-20 bg-white dark:bg-navy-950 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <img src="/images/feature-quick-log.png" alt="NinerLog Quick Log während des Fluges: Off-Block und Start bereits getippt, wartet auf die Landung" class="rounded-xl shadow-xl w-full order-last lg:order-none" loading="lazy" width="1200" height="675" />
      <div class="reveal">
        {{ badge("QUICK LOG &bull; BLOCKZEITEN LIVE") }}
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4 mt-3">Dein Flugbuch läuft mit, während du fliegst</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Quick Log am Handy öffnen, Flugzeug wählen und bei jedem Ereignis einmal tippen &mdash; Off Block, Start, Landung, On Block. Sobald du on blocks gehst, werden aus den Taps ein vollständiger Eintrag: Blockzeiten, Gesamtzeit, Route, alles ausgefüllt. Kein Blick auf die Uhr, keine Kritzeleien auf dem Kneeboard, die du abends entziffern musst.
        </p>
        <ul class="space-y-3">
          {{ check("<strong>Ein Tap pro Ereignis.</strong> Off Block, Start, Landung und On Block genau dann erfasst, wenn sie passieren") }}
          {{ check("<strong>Der Flug schreibt sich selbst.</strong> On Block erzeugt den Eintrag &mdash; prüfen, Landungen, Crew oder Bemerkungen ergänzen, fertig") }}
          {{ check("<strong>Flugplatz per GPS.</strong> Standortfreigabe erteilen und Start- und Zielflugplatz tragen sich selbst ein") }}
          {{ check("<strong>Funktioniert offline.</strong> Kein Netz am Platz? Die Taps bleiben auf dem Gerät und synchronisieren später von allein") }}
          {{ check("<strong>Flugzeug direkt anlegen.</strong> Etwas Neues geflogen? Kennzeichen und Muster ohne Umweg direkt im Screen ergänzen") }}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- 1b — Was das Flugformular für dich ausrechnet -->
<section class="bg-slate-50 dark:bg-navy-900 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mb-10 lg:mb-14 reveal">
      {{ badge("AUTOMATISCH BERECHNET") }}
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4 mt-3">Die Spalten, die niemand gern ausfüllt</h2>
      <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
        Im Papierflugbuch rechnest du Nachtzeit, Überlandzeit und Distanz selbst aus und hoffst, dass es stimmt. NinerLog leitet sie aus dem ab, was du ohnehin eingetragen hast &mdash; überschreiben kannst du jeden Wert trotzdem.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal reveal-delay-1">
      {{ card("Nachtzeit, richtig gerechnet", "Aus deinen tatsächlichen Off- und On-Block-Zeiten gegen den echten Sonnenauf- und -untergang an Start- und Zielflugplatz &mdash; keine Schätzung und nicht der ganze Flug pauschal als Nacht.") }}
      {{ card("Tag- und Nachtlandungen", "Automatisch aus der Ankunftszeit getrennt, dazu Tag- und Nachtstarts. Beides überschreibbar, wenn der Himmel anderer Meinung ist als der Kalender.") }}
      {{ card("Überland und Distanz", "Überlandzeit, sobald Start und Ziel verschieden sind; Großkreisdistanz in nautischen Meilen aus den Flugplatzkoordinaten.") }}
      {{ card("Funktionen aus der Crewliste", "PIC, Dual, Solo, SIC, erteilte Ausbildung und Multi-Pilot-Zeit ergeben sich daraus, wer an Bord war und auf welchem Sitz &mdash; du setzt die Rolle, nicht die Stoppuhr.") }}
      {{ card("Simulatorzeit bleibt getrennt", "Eine FSTD-Session führt ihre eigene Dauer und ihren FSTD-Typ (FNPT II, FFS, BATD&hellip;) und wird nie zur Flugzeit addiert &mdash; genau so, wie AMC1 FCL.050 es verlangt.", true) }}
      {{ card("Strecken als Passagier", "Nur mitgeflogen statt geflogen? Die Zeile behält Route und Blockzeiten als Beleg für die Reise und zählt in keine Summe, Statistik oder Recency.", true) }}
      {{ card("IFR im Detail", "Tatsächliche und simulierte Instrumentenzeit, Holdings und jeder Anflug mit Verfahren, Flugplatz und Piste &mdash; die Struktur, die FAA §61.51(g)(3) verlangt.") }}
      {{ card("Plätze ohne ICAO-Code", "Außenlandung, Gletscher oder ein Acker ohne Code? Ortsnamen eintippen. Er bleibt so stehen, und der Flug zählt trotzdem.", true) }}
      {{ card("Und das Ganze noch einmal", "Klasse eines Flugzeugs korrigiert oder Jahre später einen Flugplatz richtiggestellt? Ein Neuberechnungslauf leitet die abgeleiteten Felder im ganzen Flugbuch neu her.") }}
    </div>
  </div>
</section>

<!-- ============================================================
     2 — SUCHE
     ============================================================ -->
<section id="suche" class="scroll-mt-20 bg-white dark:bg-navy-950 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <img src="/images/feature-search.png" alt="Die NinerLog-Flugsuche filtert ein Flugbuch anhand eines ICAO-Codes auf die passenden Flüge" class="rounded-xl shadow-xl w-full order-last lg:order-2" loading="lazy" width="1200" height="675" />
      <div class="reveal lg:order-1">
        {{ badge("ALLES WIEDERFINDEN") }}
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4 mt-3">Ein Feld, alle Spalten</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Ein Flugbuch taugt nur so viel, wie du darin wiederfindest. Tippe ein Kennzeichen, ein Muster, einen Flugplatzcode oder ein Wort aus deinen Bemerkungen &mdash; du musst vorher kein Feld auswählen, und Teiltreffer zählen: &bdquo;EDD&ldquo; findet jeden großen deutschen Verkehrsflughafen, den du je angeflogen hast.
        </p>
        <ul class="space-y-3">
          {{ check("<strong>Filter obendrauf.</strong> Zeitraum, Kennzeichen, Start- oder Zielflugplatz und Funktion &mdash; nur PIC, nur Dual") }}
          {{ check("<strong>Das ganze Flugbuch.</strong> Die Suche läuft über jeden Flug, den du je erfasst hast, egal wie viele tausend das sind") }}
          {{ check("<strong>Filter, die bleiben.</strong> Flug öffnen, zurückgehen &mdash; Suche und Filter stehen genau da, wo du sie gelassen hast", true) }}
          {{ check("<strong>Deine Spalten, deine Liste.</strong> Datum, Route, Flugzeug und Gesamtzeit immer; alles andere wählst du selbst &mdash; oder lässt die Liste mehr Spalten zeigen, je breiter das Fenster wird", true) }}
          {{ check("<strong>Flugplätze mit Namen.</strong> In der Liste steht <em>Frankfurt am Main</em>, nicht nur EDDF &mdash; aufgelöst aus einer Datenbank mit über 29.000 Plätzen", true) }}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================
     3 — RECENCY
     ============================================================ -->
<section id="recency" class="scroll-mt-20 bg-slate-50 dark:bg-navy-900 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <img src="/images/feature-currency-tracking.png" alt="NinerLog Recency-Übersicht mit EASA-Verlängerung und FAA-90-Tage-Status" class="rounded-xl shadow-xl w-full order-last lg:order-none" loading="lazy" width="1200" height="675" />
      <div class="reveal">
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4">Nie wieder raten, ob du current bist</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          NinerLog prüft deine Flüge gegen die Regeln der Behörde, die die jeweilige Lizenz ausgestellt hat &mdash; und nennt dir das Datum, an dem deine Recency ausläuft, statt dich von heute rückwärts zählen zu lassen.
        </p>
        <ul class="space-y-3">
          {{ check("EASA-Verlängerung durch Erfahrung (FCL.740) und Passagier-Recency") }}
          {{ check("FAA 90-Tage-Passagier-Recency (14 CFR 61.57), Nacht-Recency und Flight Review (61.56)") }}
          {{ check("Instrumenten-Recency mit Zählung von Anflügen und Holdings, dazu IPC") }}
          {{ check("<strong>90-Tage-Recency je Muster und je Kennzeichen.</strong> Drei Starts und Landungen in den letzten 90 Tagen, nach Muster erfasst wie in FCL.060(b) &mdash; optional zusätzlich pro Kennzeichen als Vertrautheitshilfe", true) }}
          {{ check("<strong>Bescheid, bevor es eng wird.</strong> Ein Hinweisbanner im Dashboard samt nächstem Schritt und E-Mail-Erinnerungen 30, 14 und 7 Tage vorher &mdash; oder an den Tagen, die du wählst", true) }}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- 3b — Eigene Recency-Regeln: die wichtigste Neuerung, gezeigt als Regel selbst -->
<section class="bg-white dark:bg-navy-950 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div class="reveal">
        {{ badge("SELBST GESCHRIEBEN") }}
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4 mt-3">Recency-Regeln, die sonst niemand mitliefert</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Dein Verein will fünf Landungen im Quartal. Deine Versicherung will zehn Stunden auf Muster pro Jahr. Dein eigenes Minimum ist eine Nachtlandung alle zwei Monate. Nichts davon steht in einer Verordnung, also hat kein Flugbuch eine Karte dafür &mdash; bis du sie baust.
        </p>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Eine Regel besteht aus drei Dingen: wie weit zurückgeschaut wird, welche Flüge zählen und was du brauchst. Im Baukasten zusammenklicken oder direkt als YAML schreiben &mdash; beides ist dieselbe Regel, und du kannst mitten im Bearbeiten wechseln.
        </p>
        <ul class="space-y-3">
          {{ check("<strong>25 Kennzahlen.</strong> Flüge, Landungen und Starts (Tag oder Nacht), Anflüge, Holdings sowie Zeit als PIC, Dual, Nacht, IFR oder Überland") }}
          {{ check("<strong>Auf das Passende filtern.</strong> Nach Klasse, Muster oder Kennzeichen, nach complex, high-performance oder Spornrad, nach PIC oder Dual, Nacht, IFR oder Überland") }}
          {{ check("<strong>Vorschau auf dein echtes Flugbuch.</strong> Sieh, ob die eben geschriebene Regel dich als current führt &mdash; noch bevor du sie speicherst") }}
          {{ check("<strong>Eine Karte wie jede andere.</strong> Steht auf deiner Recency-Seite, mit eigenem Emoji und eigenem &bdquo;gültig bis&ldquo;; pausiert verblasst sie und rutscht nach unten, statt zu verschwinden") }}
          {{ check("<strong>Erinnerungen pro Regel.</strong> Bei den wichtigen die Glocke einschalten, der Rest bleibt still") }}
          {{ check("<strong>Per Link teilen.</strong> Regel veröffentlichen, Link an den Verein schicken, jedes Mitglied importiert sie mit einem Klick. Teilen aus &mdash; Link tot") }}
        </ul>
      </div>

      <div class="reveal reveal-delay-1 lg:sticky lg:top-24">
        <div class="rounded-xl overflow-hidden border border-slate-200 dark:border-navy-700 shadow-xl">
          <div class="flex items-center gap-2 px-4 py-2.5 bg-slate-100 dark:bg-navy-800 border-b border-slate-200 dark:border-navy-700">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-400/70" aria-hidden="true"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400/70" aria-hidden="true"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/70" aria-hidden="true"></span>
            <span class="ml-2 font-mono text-xs text-slate-600 dark:text-slate-400">nachtlandungen.yaml</span>
          </div>
<pre class="bg-navy-950 text-slate-300 p-5 overflow-x-auto text-xs sm:text-sm leading-relaxed font-mono"><code><span class="text-slate-400"># Name und Emoji für deine Regel.</span>
<span class="text-sky-400">name</span>: Nachtlandungen
<span class="text-sky-400">emoji</span>: <span class="text-amber-300">"&#x1F319;"</span>
<span class="text-sky-400">description</span>: Nacht-Recency für Passagiere.

<span class="text-slate-400"># Wie weit zurückschauen.</span>
<span class="text-sky-400">window</span>:
  <span class="text-sky-400">amount</span>: <span class="text-emerald-400">90</span>
  <span class="text-sky-400">unit</span>: days

<span class="text-slate-400"># Welche Flüge zählen.</span>
<span class="text-sky-400">filters</span>:
  - <span class="text-sky-400">field</span>: has_night
    <span class="text-sky-400">op</span>: is_true

<span class="text-slate-400"># Was du brauchst, um current zu bleiben.</span>
<span class="text-sky-400">requirements</span>:
  - <span class="text-sky-400">metric</span>: night_landings
    <span class="text-sky-400">min</span>: <span class="text-emerald-400">3</span>
    <span class="text-sky-400">label</span>: Nachtlandungen
</code></pre>
        </div>
        <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">
          Dieselbe Regel im Baukasten: ein 90-Tage-Fenster, ein Filter, eine Anforderung. Nichts zu installieren, nichts zu skripten.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================
     4 — NACHWEISE
     ============================================================ -->
<section id="nachweise" class="scroll-mt-20 bg-slate-50 dark:bg-navy-900 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mb-10 lg:mb-14 reveal">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4">Lizenzen, Medicals und alles andere mit Ablaufdatum</h2>
      <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
        Lizenzen von mehr als einer Behörde &mdash; etwa eine EASA-Lizenz und ein FAA-Certificate? Flüge zählen auf jede Lizenz und jede Klassenberechtigung, für die sie gelten &mdash; ohne dass du Flüge einzeln zuordnen musst. Und die Mappe voller Nachweise, die drumherum abläuft, liegt am selben Ort.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal reveal-delay-1">
      {{ card("Jede Behörde, nebeneinander", "EASA, FAA, UK CAA oder wer auch immer deine ausgestellt hat. Lizenz anlegen, Klassenberechtigungen mit Ausstellungs- und Ablaufdatum ergänzen &mdash; jeder Flug landet dort, wo er hingehört.") }}
      {{ card("Klassenberechtigungen mit Ablauf", "SEP, MEP, SET, TMG und IR, jede mit eigener Gültigkeit, Verlängerungsstand und Ablaufdatum.") }}
      {{ card("Medicals und Zeugnisse", "EASA Klasse 1, 2 und LAPL; FAA First, Second und Third Class; ICAO-Sprachniveau 4 bis 6; Zuverlässigkeitsüberprüfungen; BZF I/II und AZF.", true) }}
      {{ card("Ein Foto des echten Dokuments", "Scans oder Fotos zu Lizenz oder Medical hinterlegen &mdash; JPEG, PNG oder PDF &mdash; und sie erscheinen als Leiste auf der Karte. Praktisch an dem Tag, an dem eine Rampenkontrolle danach fragt.", true) }}
      {{ card("Erinnerungen nach deinem Geschmack", "Wähle, welche Kategorien dir schreiben, wie viele Tage vorher gewarnt wird und zu welcher Stunde. Oder schalte E-Mails ganz ab und behalte die Warnungen im Bildschirm.") }}
      {{ card("Personen und Crew", "Fluglehrer, Safety Pilots und die Leute hinten &mdash; als Kontakte gepflegt, nach Namen entdoppelt, mit ihren Flügen verknüpft und als vCard ins Adressbuch exportierbar.", true) }}
    </div>
  </div>
</section>

<!-- ============================================================
     5 — AUSWERTUNG
     ============================================================ -->
<section id="auswertung" class="scroll-mt-20 bg-white dark:bg-navy-950 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <img src="/images/feature-reports.png" alt="NinerLog Auswertungen mit Diagrammen, Flugstatistiken und Streckenkarten" class="rounded-xl shadow-xl w-full order-last lg:order-2" loading="lazy" width="1200" height="675" />
      <div class="reveal lg:order-1">
        {{ badge("NEU GEBAUT &bull; SIEBEN KAPITEL") }}
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4 mt-3">Deine gesamte Fliegerei, vorgelesen</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Kein Summenkasten, sondern ein Bericht. Wähle einen Zeitraum von zwölf Monaten bis zu allem und lies dein Flugbuch in sieben Kapiteln, von denen jedes eine andere Frage beantwortet.
        </p>
        <ul class="space-y-3">
          {{ check("<strong>Überblick.</strong> Gesamtstunden als steigende Kurve, Stunden pro Monat, Flüge, Landungen, Flugplätze, Länder, Tage seit dem letzten Flug") }}
          {{ check("<strong>Erfahrung.</strong> Wie sich die Zeit auf PIC, Dual, Solo, Nacht, IFR und Überland verteilt, Jahr für Jahr &mdash; und nach Fluglehrer und Crewmitglied") }}
