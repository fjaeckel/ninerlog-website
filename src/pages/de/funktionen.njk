        { "cat": "Ausbildung", "items": ["Fluglehrer-Unterschrift", "Vor Ort oder aus der Ferne", "Signaturlink als QR-Code", "Unterschrift sperrt den Eintrag", "Widerruf mit Nachweis", "Feld für Endorsements"] },
        { "cat": "Auswertung", "items": ["Kurve der Gesamtstunden", "Funktionen nach Jahr", "Nach Muster, Kennzeichen, Klasse", "Flugplätze, Länder, Strecken", "Anflugverfahren", "Flugmuster", "Rekorde und Serien", "Startwert an Vorerfahrung"] },
        { "cat": "Karten", "items": ["Streckenkarten", "Flugplatz-Heatmap", "Über 29.000 Flugplätze", "Offline-Flugplatzpaket"] },
        { "cat": "Import", "items": ["12 Formate automatisch erkannt", "ForeFlight, LogTen, SkyDemon…", "Drag & Drop", "Vorschau und Dublettenwarnung", "Flotte entsteht aus den Zeilen", "JSON-Backup zurückspielen"] },
        { "cat": "Export", "items": ["Unterschreibbares PDF-Logbuch", "EASA- und FAA-Layout", "A4 / A5 / Letter, Doppel- oder Einzelseite", "CSV in drei Spaltensätzen", "Vollständiges JSON-Backup", "Kontakte als vCard"] },
        { "cat": "Backup", "items": ["S3-kompatible Buckets", "SFTP-Server", "WebDAV-Freigaben", "Täglich / wöchentlich / monatlich", "Aufbewahrung und Laufhistorie", "AES-256-GCM für Zugangsdaten"] },
        { "cat": "Sicherheit", "items": ["Anmeldung per Passkey", "Zwei-Faktor (TOTP)", "Wiederherstellungscodes", "Aktive Sitzungen verwalten", "OIDC Single Sign-on", "Passwortrichtlinie"] },
        { "cat": "Vereinsbetrieb", "items": ["Adminkonsole", "Nutzerverwaltung", "Ankündigungen", "Manipulationsresistentes Audit-Log", "E-Mail-Zustellung und Sperrliste", "Update-Prüfung"] },
        { "cat": "Plattform", "items": ["Progressive Web App", "Funktioniert offline", "Deutsch und Englisch", "Hilfe in der App", "Willkommenstour", "Hell und dunkel"] },
        { "cat": "Offen", "items": ["Self-Hosting per Docker", "Dokumentierte OpenAPI-Spec", "Delta-Sync und Tombstones", "API AGPL-3.0, Frontend MIT", "Sicherheitsfixes öffentlich", "Keine Bezahlversion"] }
      ] %}
      {% for group in features %}
      <div class="p-6 bg-white dark:bg-navy-800 rounded-xl reveal reveal-delay-{{ loop.index if loop.index < 9 else 8 }}">
        <h3 class="text-sm font-bold text-sky-700 dark:text-sky-500 uppercase tracking-wider mb-3">{{ group.cat }}</h3>
        <ul class="space-y-2">
          {% for item in group.items %}
          <li class="flex items-start gap-2 text-sm text-slate-600 dark:text-slate-300">
            <svg class="w-4 h-4 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            {{ item }}
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

