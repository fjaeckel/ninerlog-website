{% set pageTitle = "Features — NinerLog" %}
{% set pageDescription = "Flight logging, multi-license support, currency tracking, import/export, user-owned offsite cloud backup, and more. Every feature free, forever." %}
{% set pagePath = "/features" %}
{% set sitemapChangefreq = "monthly" %}
{% set sitemapPriority = "0.9" %}
{% extends "layouts/base.njk" %}

{% block content %}

<!-- ============================================================
     HERO
     ============================================================ -->
<section class="relative bg-navy-900 bg-linear-to-br from-navy-900 via-navy-800 to-navy-950 py-16 lg:py-24 overflow-hidden">
  <!-- Topographic overlay -->
  <div class="absolute inset-0 bg-topo-pattern pointer-events-none" aria-hidden="true"></div>
  <div class="max-w-6xl mx-auto px-4 text-center relative z-10">
    <div class="mb-4 reveal">
      <span class="freq-badge">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-blink"></span>
        ALL FEATURES &bull; ZERO COST
      </span>
    </div>
    <h1 class="text-4xl lg:text-5xl font-extrabold tracking-tight text-white text-balance reveal reveal-delay-1">
      Built for pilots who care<br class="hidden sm:block" /> about their data.
    </h1>
    <p class="mt-6 text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto reveal reveal-delay-2">
      Every feature designed by pilots, for pilots. No bloat, no gimmicks &mdash; just the tools you need.
    </p>
  </div>
  <div class="absolute bottom-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-sky-500/20 to-transparent" aria-hidden="true"></div>
</section>

<!-- ============================================================
     FEATURE DETAIL BLOCKS (alternating)
     ============================================================ -->

<!-- Flight Logging -->
<section class="bg-white dark:bg-navy-950 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <img src="/images/feature-flight-logging.png" alt="NinerLog flight logging interface showing quick entry, block times, and landing tracking" class="rounded-xl shadow-xl w-full order-last lg:order-none" loading="lazy" width="1200" height="675" />
      <div class="reveal">
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4">Flight Logging</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Log every detail of every flight. From off-blocks to on-blocks, landings to approaches, NinerLog captures it all. Quick entry templates turn logging into a 30-second habit.
        </p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Quick entry for rapid flight logging</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Block times, flight times, and advanced time splits</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Day and night landings tracked separately</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">IFR approaches, holds, and instrument time</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Quick Log -->
<section class="bg-slate-50 dark:bg-navy-900 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <img src="/images/feature-quick-log.png" alt="NinerLog Quick Log screen mid-session, showing off-block and takeoff already tapped and awaiting landing" class="rounded-xl shadow-xl w-full order-last lg:order-2" loading="lazy" width="1200" height="675" />
      <div class="reveal lg:order-1">
        <span class="freq-badge mb-4">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-blink"></span>
          NEW &bull; LIVE BLOCK TIMES
        </span>
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4 mt-3">Quick Log</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Your logbook, running while you fly. Open Quick Log on your phone, pick your aircraft, and tap once at each milestone &mdash; off block, takeoff, landing, on block. The moment you go on blocks, NinerLog turns your taps into a complete flight entry: block times, total time, and route, all filled in automatically. No watch-glancing, no kneeboard scribbles to decipher later.
        </p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300"><strong>One tap per event.</strong> Capture off-block, takeoff, landing, and on-block times the second they happen</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300"><strong>The flight logs itself.</strong> Going on blocks creates the logbook entry with block times, total time, and route already filled in &mdash; just review and add landings, crew, or remarks</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300"><strong>GPS airport detection.</strong> Grant location access and your departure and arrival airports fill themselves in</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300"><strong>Works offline.</strong> No signal at the airfield? Taps are saved on your device and sync automatically when you&rsquo;re back online</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300"><strong>Add aircraft on the spot.</strong> Flying something new? Quick-add its registration and type without leaving the screen</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Powerful Flight Search -->
<section class="bg-white dark:bg-navy-950 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <img src="/images/feature-search.png" alt="NinerLog flight search narrowing a logbook down to matching flights by ICAO code" class="rounded-xl shadow-xl w-full order-last lg:order-none" loading="lazy" width="1200" height="675" />
      <div class="reveal">
        <span class="freq-badge mb-4">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-blink"></span>
          NEW &bull; FIND ANYTHING
        </span>
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4 mt-3">Powerful Flight Search</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          A logbook is only as good as your ability to find things in it. Type anything into the search box above your flight list &mdash; a registration, an aircraft type, an airport code, or a word you wrote in the remarks &mdash; and NinerLog instantly narrows your logbook to matching flights. There&rsquo;s no field to pick first: one search sweeps registration, type, departure and arrival ICAO, and remarks all at once, and partial matches count, so &ldquo;EDD&rdquo; finds every big German airport you&rsquo;ve ever visited.
        </p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300"><strong>One box, every field.</strong> Registration, aircraft type, departure and arrival ICAO, and remarks &mdash; searched together, case-insensitive</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300"><strong>Partial matches count.</strong> Type &ldquo;172&rdquo; for every Skyhawk flight, or &ldquo;crosswind&rdquo; to dig up that remark from two years ago</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300"><strong>Combine with filters.</strong> Stack date range, aircraft registration, departure or arrival airport, and pilot function (PIC only, dual only) on top of your search</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300"><strong>Sort your results.</strong> Order matches by date, hours, or when they were added</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300"><strong>Your whole logbook, not just this page.</strong> Search runs across every flight you&rsquo;ve ever logged, however many thousands that is</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Multi-License Management -->
<section class="bg-slate-50 dark:bg-navy-900 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <img src="/images/feature-multi-license.png" alt="NinerLog multi-license management showing EASA and FAA licenses with class ratings and expiry dates" class="rounded-xl shadow-xl w-full order-last lg:order-2" loading="lazy" width="1200" height="675" />
