            <span class="text-slate-600 dark:text-slate-300">Import from CSV and XLS</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Automatic field mapping and validation</span>
