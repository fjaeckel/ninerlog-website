      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 lg:gap-8">
      {% set features = [
        { "cat": "Logging", "items": ["Quick Log (live block times)", "Block, flight and split times", "Day & night landings and takeoffs", "IFR time, approaches and holds", "FSTD sessions kept separate", "Passenger legs", "Off-airport locations", "Route waypoints"] },
        { "cat": "Auto-calculated", "items": ["Night time from real sunset", "Day/night landing split", "Cross-country time", "Distance in NM", "PIC, solo, SIC, dual given", "Multi-pilot time"] },
        { "cat": "Search", "items": ["One-box full-text search", "Date, aircraft, airport, function filters", "Filters that persist", "Choose your columns", "Adaptive column widths", "Airport names resolved"] },
        { "cat": "Currency", "items": ["EASA FCL.740 revalidation", "FAA 61.57 recency", "Instrument currency & IPC", "Flight review (61.56)", "90-day recency by model & tail", "Custom currency rules", "Rule sharing by link", "Per-rule email reminders"] },
        { "cat": "Licences", "items": ["Any authority worldwide", "Class ratings (SEP/MEP/SET/TMG/IR)", "No per-licence assignment", "Medicals & credentials", "AZF / BZF / ICAO language", "Document photos & PDFs", "Expiry notifications"] },
        { "cat": "Fleet", "items": ["Per-aircraft statistics", "90-day recency per aircraft", "Logging defaults", "Complex / HP / tailwheel", "Registration normalisation", "Re-registration carry-over"] },
        { "cat": "Training", "items": ["Instructor signing", "In-person or remote signing", "QR code signing links", "Signature-locked entries", "Void with audit trail", "Endorsements field"] },
        { "cat": "Reports", "items": ["Career hours curve", "Role split by year", "By type, registration, class", "Airports, countries, routes", "Approach types", "Flying patterns", "Personal records & streaks", "Prior-experience snapshot"] },
        { "cat": "Maps", "items": ["Route maps", "Airport heatmap", "29,000+ airport database", "Offline airport pack"] },
        { "cat": "Import", "items": ["12 formats auto-detected", "ForeFlight, LogTen, SkyDemon…", "Drag & drop", "Preview & duplicate warnings", "Fleet created from rows", "JSON backup restore"] },
        { "cat": "Export", "items": ["Signable PDF logbook", "EASA & FAA layouts", "A4 / A5 / Letter, spread or single", "CSV in three column sets", "Full JSON backup", "vCard contacts"] },
        { "cat": "Backup", "items": ["S3-compatible buckets", "SFTP servers", "WebDAV shares", "Daily / weekly / monthly", "Retention & run history", "AES-256-GCM credentials"] },
        { "cat": "Security", "items": ["Passkey sign-in", "Two-factor auth (TOTP)", "Recovery codes", "Active session management", "OIDC single sign-on", "Password complexity policy"] },
        { "cat": "Club ops", "items": ["Admin console", "User management", "Announcements", "Tamper-resistant audit log", "Email delivery & suppressions", "Release update checker"] },
        { "cat": "Platform", "items": ["Progressive web app", "Works offline", "English & German", "In-app Help Base", "Guided welcome tour", "Light & dark themes"] },
        { "cat": "Open", "items": ["Self-hosting via Docker", "Documented OpenAPI spec", "Delta sync & tombstones", "AGPL-3.0 API, MIT frontend", "Public security fixes", "No paid tier"] }
      ] %}
      {% for group in features %}
      <div class="p-6 bg-white dark:bg-navy-800 rounded-xl reveal reveal-delay-{{ loop.index if loop.index < 9 else 8 }}">
        <h3 class="text-sm font-bold text-sky-700 dark:text-sky-500 uppercase tracking-wider mb-3">{{ group.cat }}</h3>
        <ul class="space-y-2">
          {% for item in group.items %}
          <li class="flex items-start gap-2 text-sm text-slate-600 dark:text-slate-300">
            <svg class="w-4 h-4 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            {{ item }}
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

