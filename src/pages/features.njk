{% set pageTitle = "Features — NinerLog" %}
{% set pageDescription = "Flight logging, multi-license support, currency tracking, import/export, and more. Every feature free, forever." %}
{% set pagePath = "/features" %}
{% extends "layouts/base.njk" %}

{% block content %}

<!-- ============================================================
     HERO
     ============================================================ -->
<section class="relative bg-linear-to-br from-navy-900 via-navy-800 to-navy-950 py-16 lg:py-24 overflow-hidden">
  <!-- Topographic overlay -->
  <div class="absolute inset-0 bg-topo-pattern pointer-events-none" aria-hidden="true"></div>
  <div class="max-w-6xl mx-auto px-4 text-center relative z-10">
    <div class="mb-4 reveal">
      <span class="freq-badge">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-blink"></span>
        ALL FEATURES &bull; ZERO COST
      </span>
    </div>
    <h1 class="text-4xl lg:text-5xl font-extrabold tracking-tight text-white text-balance reveal reveal-delay-1">
      Built for pilots who care<br class="hidden sm:block" /> about their data.
    </h1>
    <p class="mt-6 text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto reveal reveal-delay-2">
      Every feature designed by pilots, for pilots. No bloat, no gimmicks &mdash; just the tools you need.
    </p>
  </div>
  <div class="absolute bottom-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-sky-500/20 to-transparent" aria-hidden="true"></div>
</section>

<!-- ============================================================
     FEATURE DETAIL BLOCKS (alternating)
     ============================================================ -->

<!-- Flight Logging -->
<section class="bg-white dark:bg-navy-950 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="bg-slate-100 dark:bg-navy-800 rounded-xl shadow-xl aspect-video flex items-center justify-center">
        <div class="text-center p-8">
          <svg class="w-16 h-16 text-sky-500 mx-auto mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          <p class="text-sm text-slate-500 dark:text-slate-400">App screenshot coming soon</p>
        </div>
      </div>
      <div class="reveal">
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4">Flight Logging</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Log every detail of every flight. From off-blocks to on-blocks, landings to approaches, NinerLog captures it all. Quick entry templates turn logging into a 30-second habit.
        </p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Quick entry for rapid flight logging</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Block times, flight times, and advanced time splits</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Day and night landings tracked separately</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">IFR approaches, holds, and instrument time</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Multi-License Management -->
<section class="bg-slate-50 dark:bg-navy-900 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="reveal lg:order-2">
        <div class="bg-slate-100 dark:bg-navy-800 rounded-xl shadow-xl aspect-video flex items-center justify-center">
          <div class="text-center p-8">
            <svg class="w-16 h-16 text-amber-500 mx-auto mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
            <p class="text-sm text-slate-500 dark:text-slate-400">App screenshot coming soon</p>
          </div>
        </div>
      </div>
      <div class="reveal lg:order-1">
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4">Multi-License Management</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Hold a PPL and SPL? EASA and FAA? NinerLog handles them all. Flights count toward all applicable licenses and class ratings automatically.
        </p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Any regulatory authority worldwide</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Class ratings with expiry tracking (SEP, MEP, TMG, IR)</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">No per-license flight assignment &mdash; flights count everywhere</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Currency Tracking -->
<section class="bg-white dark:bg-navy-950 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="bg-slate-100 dark:bg-navy-800 rounded-xl shadow-xl aspect-video flex items-center justify-center">
        <div class="text-center p-8">
          <svg class="w-16 h-16 text-emerald-500 mx-auto mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          <p class="text-sm text-slate-500 dark:text-slate-400">App screenshot coming soon</p>
        </div>
      </div>
      <div class="reveal">
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4">Currency Tracking</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Never guess if you&rsquo;re current again. NinerLog evaluates your flights against EASA and FAA rules automatically.
        </p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">EASA revalidation rules (FCL.740)</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">FAA 90-day passenger currency (14 CFR 61.57)</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Instrument currency tracking with approach counting</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Import & Export -->
<section class="bg-slate-50 dark:bg-navy-900 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="reveal lg:order-2">
        <div class="bg-slate-100 dark:bg-navy-800 rounded-xl shadow-xl aspect-video flex items-center justify-center">
          <div class="text-center p-8">
            <svg class="w-16 h-16 text-cyan-500 mx-auto mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/></svg>
            <p class="text-sm text-slate-500 dark:text-slate-400">App screenshot coming soon</p>
          </div>
        </div>
      </div>
      <div class="reveal lg:order-1">
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4">Import &amp; Export</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Switching from another logbook? Bring your data in. Want to leave? Take everything with you. Your data is never trapped.
        </p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Import from CSV, XLS, and ForeFlight</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Export to CSV, PDF, and JSON</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Full database backup anytime</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================
     FULL FEATURE GRID
     ============================================================ -->
<section class="bg-white dark:bg-navy-950 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-3xl lg:text-4xl font-bold tracking-tight text-slate-800 dark:text-white reveal">
        The full picture.
      </h2>
      <p class="mt-4 text-lg text-slate-500 dark:text-slate-400 max-w-2xl mx-auto reveal reveal-delay-1">
        Every feature at a glance. All free, forever.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 lg:gap-8">
      {% set features = [
        { "cat": "Core", "items": ["Flight Logging", "Quick Entry", "Block Times", "Day & Night Landings"] },
        { "cat": "Licenses", "items": ["Multi-License", "Class Ratings (SEP/MEP/TMG/IR)", "Any Authority Worldwide"] },
        { "cat": "Tracking", "items": ["Currency Tracking", "Credentials & Medicals", "Expiry Notifications"] },
        { "cat": "Fleet", "items": ["Aircraft Management", "Flight Form Integration"] },
        { "cat": "Data", "items": ["Import (CSV/XLS/ForeFlight)", "Export (CSV/PDF/JSON)", "Full Backup"] },
        { "cat": "Visualization", "items": ["Reports & Charts", "Route Maps", "Airport Heatmap"] },
        { "cat": "Pro", "items": ["Instrument Tracking", "People & Crew", "Auto-Calculations"] },
        { "cat": "Platform", "items": ["Self-Hosting", "Security Hardened", "MIT Licensed"] }
      ] %}
      {% for group in features %}
      <div class="p-6 bg-slate-50 dark:bg-navy-800 rounded-xl reveal reveal-delay-{{ loop.index }}">
        <h3 class="text-sm font-bold text-sky-500 uppercase tracking-wider mb-3">{{ group.cat }}</h3>
        <ul class="space-y-2">
          {% for item in group.items %}
          <li class="flex items-start gap-2 text-sm text-slate-600 dark:text-slate-300">
            <svg class="w-4 h-4 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            {{ item }}
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ============================================================
     CTA
     ============================================================ -->
<section class="bg-linear-to-b from-navy-900 to-navy-950 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4 text-center">
    <h2 class="text-3xl lg:text-4xl font-bold tracking-tight text-white reveal">
      See for yourself.
    </h2>
    <p class="mt-4 text-lg text-slate-300 max-w-xl mx-auto reveal reveal-delay-1">
      Every feature. Free. No trial period, no feature gates, no &ldquo;upgrade to Pro.&rdquo;
    </p>
    <div class="mt-8 reveal reveal-delay-2">
      <a href="https://app.ninerlog.com/register"
         class="inline-flex items-center gap-2 px-8 py-4
                bg-linear-to-r from-amber-400 to-amber-500
                text-navy-900 font-semibold text-lg
                rounded-full
                shadow-lg shadow-amber-400/30
                hover:shadow-xl hover:shadow-amber-400/40 hover:scale-[1.02]
                active:scale-[0.98]
                transition-all duration-200">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
        Start Logging &mdash; It&rsquo;s Free
      </a>
      <p class="mt-3 text-sm text-slate-400">
        <span class="font-mono text-xs text-slate-500 tracking-wider">SQUAWK 7000</span> &mdash; VFR and free to fly.
      </p>
    </div>
  </div>
</section>

{% endblock %}
