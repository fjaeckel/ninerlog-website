<section id="credentials" class="scroll-mt-20 bg-slate-50 dark:bg-navy-900 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mb-10 lg:mb-14 reveal">
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4">Licences, medicals, and everything else with a date on it</h2>
      <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
        Licences from more than one authority &mdash; an EASA licence and an FAA certificate, say? Flights count toward every licence and class rating they apply to, with no per-licence assignment to remember. And the wallet full of certificates that expires around them lives in the same place.
      </p>
    </div>
    <div class="mb-10 lg:mb-14 reveal reveal-delay-1">
      <img src="/images/feature-credentials.png" alt="NinerLog credentials page listing an EASA Class 2 medical about to expire, a lifetime radio certificate, and an expired ICAO language proficiency entry" class="rounded-xl shadow-xl w-full dark:hidden" loading="lazy" width="1200" height="675" />
      <img src="/images/feature-credentials-dark.png" alt="NinerLog credentials page listing an EASA Class 2 medical about to expire, a lifetime radio certificate, and an expired ICAO language proficiency entry" class="rounded-xl shadow-xl w-full hidden dark:block" loading="lazy" width="1200" height="675" />
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal reveal-delay-1">
      {{ card("Any authority, side by side", "EASA, FAA, UK CAA, or whoever issued yours. Add the licence, add its class ratings with issue and expiry dates, and every flight lands where it belongs.") }}
      {{ card("Class ratings that expire", "SEP, MEP, SET, TMG and IR, each with its own validity, revalidation status, and the date it runs out.") }}
      {{ card("Medicals and certificates", "EASA Class 1, 2 and LAPL; FAA First, Second and Third Class; ICAO language proficiency levels 4 to 6; security clearances; BZF I/II and AZF radio certificates.", true) }}
      {{ card("A photo of the actual document", "Attach scans or photos of a licence or medical &mdash; JPEG, PNG or PDF &mdash; and they show as a strip on the card. Useful the day a ramp check asks for one.", true) }}
      {{ card("Reminders you control", "Pick which categories email you, how many days ahead they warn, and the hour of day they arrive. Or switch email off entirely and keep the on-screen warnings.") }}
      {{ card("People and crew", "Instructors, safety pilots and the friends in the back, kept as contacts, deduplicated by name and linked to their flights &mdash; and exportable as vCards to your phone&rsquo;s address book.", true) }}
    </div>
  </div>
</section>

