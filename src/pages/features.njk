  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="w-full order-last lg:order-2">
        <img src="/images/feature-search.png" alt="NinerLog flight search narrowing a logbook down to matching flights by ICAO code" class="rounded-xl shadow-xl w-full dark:hidden" loading="lazy" width="1200" height="675" />
        <img src="/images/feature-search-dark.png" alt="NinerLog flight search narrowing a logbook down to matching flights by ICAO code" class="rounded-xl shadow-xl w-full hidden dark:block" loading="lazy" width="1200" height="675" />
      </div>
      <div class="reveal lg:order-1">
        {{ badge("FIND ANYTHING") }}
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4 mt-3">One box, every field</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          A logbook is only as good as your ability to find things in it. Type a registration, an aircraft type, an airport code, or a word you wrote in the remarks &mdash; there is no field to pick first, and partial matches count, so &ldquo;EDD&rdquo; finds every big German airport you have ever visited.
        </p>
        <ul class="space-y-3">
          {{ check("<strong>Stack filters on top.</strong> Date range, registration, departure or arrival airport, and pilot function &mdash; PIC only, dual only") }}
          {{ check("<strong>Your whole logbook.</strong> Search runs across every flight you have ever logged, however many thousands that is") }}
          {{ check("<strong>Filters that stay put.</strong> Open a flight, come back, and your search and filters are exactly where you left them", true) }}
          {{ check("<strong>Your columns, your list.</strong> The list always shows date, route, aircraft and total time; everything else is yours to pick &mdash; or let it reveal more columns as the window gets wider", true) }}
          {{ check("<strong>Airports by name.</strong> Flights show <em>Frankfurt am Main</em>, not just EDDF, resolved from a merged database of over 29,000 airports", true) }}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================
