{% set pageTitle = "Features — NinerLog" %}
{% set pageDescription = "Flight logging, multi-license support, currency tracking, import/export, user-owned offsite cloud backup, and more. Every feature free, forever." %}
{% set pagePath = "/features" %}
{% extends "layouts/base.njk" %}

{% block content %}

<!-- ============================================================
     HERO
     ============================================================ -->
<section class="relative bg-linear-to-br from-navy-900 via-navy-800 to-navy-950 py-16 lg:py-24 overflow-hidden">
  <!-- Topographic overlay -->
  <div class="absolute inset-0 bg-topo-pattern pointer-events-none" aria-hidden="true"></div>
  <div class="max-w-6xl mx-auto px-4 text-center relative z-10">
    <div class="mb-4 reveal">
      <span class="freq-badge">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-blink"></span>
        ALL FEATURES &bull; ZERO COST
      </span>
    </div>
    <h1 class="text-4xl lg:text-5xl font-extrabold tracking-tight text-white text-balance reveal reveal-delay-1">
      Built for pilots who care<br class="hidden sm:block" /> about their data.
    </h1>
    <p class="mt-6 text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto reveal reveal-delay-2">
      Every feature designed by pilots, for pilots. No bloat, no gimmicks &mdash; just the tools you need.
    </p>
  </div>
  <div class="absolute bottom-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-sky-500/20 to-transparent" aria-hidden="true"></div>
</section>

<!-- ============================================================
     FEATURE DETAIL BLOCKS (alternating)
     ============================================================ -->

<!-- Flight Logging -->
<section class="bg-white dark:bg-navy-950 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <img src="/images/feature-flight-logging.png" alt="NinerLog flight logging interface showing quick entry, block times, and landing tracking" class="rounded-xl shadow-xl w-full order-last lg:order-none" loading="lazy" width="1200" height="675" />
      <div class="reveal">
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4">Flight Logging</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Log every detail of every flight. From off-blocks to on-blocks, landings to approaches, NinerLog captures it all. Quick entry templates turn logging into a 30-second habit.
        </p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Quick entry for rapid flight logging</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Block times, flight times, and advanced time splits</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Day and night landings tracked separately</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">IFR approaches, holds, and instrument time</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Multi-License Management -->
<section class="bg-slate-50 dark:bg-navy-900 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <img src="/images/feature-multi-license.png" alt="NinerLog multi-license management showing EASA and FAA licenses with class ratings and expiry dates" class="rounded-xl shadow-xl w-full order-last lg:order-2" loading="lazy" width="1200" height="675" />
      <div class="reveal lg:order-1">
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4">Multi-License Management</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Hold a PPL and SPL? EASA and FAA? NinerLog handles them all. Flights count toward all applicable licenses and class ratings automatically.
        </p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Any regulatory authority worldwide</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Class ratings with expiry tracking (SEP, MEP, TMG, IR)</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">No per-license flight assignment &mdash; flights count everywhere</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Currency Tracking -->
<section class="bg-white dark:bg-navy-950 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <img src="/images/feature-currency-tracking.png" alt="NinerLog currency tracking dashboard with EASA revalidation and FAA 90-day currency status" class="rounded-xl shadow-xl w-full order-last lg:order-none" loading="lazy" width="1200" height="675" />
      <div class="reveal">
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4">Currency Tracking</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Never guess if you&rsquo;re current again. NinerLog evaluates your flights against EASA and FAA rules automatically.
        </p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">EASA revalidation rules (FCL.740)</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">FAA 90-day passenger currency (14 CFR 61.57)</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-slate-600 dark:text-slate-300">Instrument currency tracking with approach counting</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Import -->
