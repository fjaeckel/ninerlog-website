        <div class="flex items-center justify-between mb-4">
          <svg class="w-8 h-8 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          <span class="text-xs uppercase tracking-wider text-amber-600 bg-amber-100 dark:bg-amber-900/30 dark:text-amber-400 px-2 py-0.5 rounded-full font-semibold">Planned</span>
        </div>
        <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Offline Support</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">Full PWA with service worker. Log flights without internet, sync when you&rsquo;re back online.</p>
      </div>

      <!-- Digital Signatures -->
      <div class="p-6 border-2 border-dashed border-slate-300 dark:border-navy-600 rounded-xl reveal reveal-delay-2">
        <div class="flex items-center justify-between mb-4">
          <svg class="w-8 h-8 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          <span class="text-xs uppercase tracking-wider text-amber-600 bg-amber-100 dark:bg-amber-900/30 dark:text-amber-400 px-2 py-0.5 rounded-full font-semibold">Planned</span>
        </div>
        <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Digital Signatures</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">Instructor and examiner sign-off per flight. Digital proof of competency checks.</p>
      </div>

      <!-- Photo Attachments -->
      <div class="p-6 border-2 border-dashed border-slate-300 dark:border-navy-600 rounded-xl reveal reveal-delay-3">
        <div class="flex items-center justify-between mb-4">
          <svg class="w-8 h-8 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          <span class="text-xs uppercase tracking-wider text-amber-600 bg-amber-100 dark:bg-amber-900/30 dark:text-amber-400 px-2 py-0.5 rounded-full font-semibold">Planned</span>
        </div>
        <h3 class="text-lg font-semibold text-slate-800 dark:text-white mb-2">Photo Attachments</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">Attach receipts, certificates, and photos to flights and credentials.</p>
      </div>
    </div>
  </div>
</section>

