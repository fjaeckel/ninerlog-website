{% set pageTitle = "Features — NinerLog" %}
{% set pageDescription = "Quick Log, custom currency rules, full logbook analytics, twelve import formats, signable PDF logbooks, backups to storage you own. Open source and free to use." %}
{% set pagePath = "/features" %}
{% set altDe = "/de/funktionen" %}
{% set sitemapChangefreq = "monthly" %}
{% set sitemapPriority = "0.9" %}
{% extends "layouts/base.njk" %}

{% block content %}

{# Repeated list item and card shapes. Defined once so a section reads as its
   content rather than as forty lines of the same SVG. #}
{% macro check(text, isNew) %}
<li class="flex items-start gap-3">
  <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
  <span class="text-slate-600 dark:text-slate-300">{{ text | safe }}{% if isNew %} <span class="ml-0.5 align-middle text-[10px] font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">New</span>{% endif %}</span>
</li>
{% endmacro %}

{% macro card(title, body, isNew) %}
<div class="p-6 bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
  <h3 class="text-base font-semibold text-slate-800 dark:text-white mb-2">
    {{ title | safe }}{% if isNew %} <span class="ml-1 align-middle text-[10px] font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">New</span>{% endif %}
  </h3>
  <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{{ body | safe }}</p>
</div>
{% endmacro %}

{# `dot` takes a whole class name, not a colour fragment: Tailwind scans this
   file as plain text and never sees a class assembled from parts. #}
{% macro badge(text, dot) %}
<span class="freq-badge mb-4">
  <span class="inline-block w-1.5 h-1.5 rounded-full {{ dot | default('bg-emerald-400') }} animate-blink"></span>
  {{ text | safe }}
</span>
{% endmacro %}

<!-- ============================================================
     HERO — no call to action. This page exists to be read.
     ============================================================ -->
<section class="relative bg-navy-900 bg-linear-to-br from-navy-900 via-navy-800 to-navy-950 py-16 lg:py-24 overflow-hidden">
  <div class="absolute inset-0 bg-topo-pattern pointer-events-none" aria-hidden="true"></div>
  <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
    <div class="mb-4 reveal">
      <span class="freq-badge">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-blink"></span>
        OPEN SOURCE &bull; FREE TO USE
      </span>
    </div>
    <h1 class="text-4xl lg:text-5xl font-extrabold tracking-tight text-white text-balance reveal reveal-delay-1">
      A logbook that does<br class="hidden sm:block" /> the paperwork.
    </h1>
    <p class="mt-6 text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto reveal reveal-delay-2">
      Night time from the actual sunset at your arrival airport. Currency rules you can write yourself. A PDF logbook your instructor can sign, page by page. Here is everything NinerLog does &mdash; take your time.
    </p>
  </div>
  <div class="absolute bottom-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-sky-500/20 to-transparent" aria-hidden="true"></div>
</section>

<!-- ============================================================
     CHAPTER NAV — the page is long on purpose; this makes it browsable
     ============================================================ -->
<nav class="bg-slate-50 dark:bg-navy-900 border-b border-slate-200 dark:border-navy-800" aria-label="Feature sections">
  {# One scrolling row on a phone, where thirteen wrapped pills would fill the
     screen; wrapped and centred from sm up. #}
