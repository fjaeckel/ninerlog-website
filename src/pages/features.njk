      { href: "#logging", label: "Logging" },
      { href: "#search", label: "Search" },
      { href: "#currency", label: "Currency" },
      { href: "#credentials", label: "Credentials" },
      { href: "#reports", label: "Reports" },
      { href: "#fleet", label: "Fleet" },
      { href: "#signing", label: "Instructor signing" },
      { href: "#import", label: "Import" },
      { href: "#export", label: "Export" },
      { href: "#backup", label: "Backup" },
      { href: "#security", label: "Security" },
      { href: "#club", label: "Clubs" },
      { href: "#everywhere", label: "Everywhere" }
    ] %}
    {% for c in chapters %}
    <a href="{{ c.href }}"
       class="shrink-0 whitespace-nowrap px-3 py-1.5 text-sm rounded-full border border-slate-300 dark:border-navy-700 text-slate-600 dark:text-slate-300
              hover:border-sky-500 hover:text-sky-600 dark:hover:text-sky-400 transition-colors">{{ c.label }}</a>
    {% endfor %}
