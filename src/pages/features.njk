</nav>

<!-- ============================================================
     1 — LOGGING
     ============================================================ -->
<section id="logging" class="scroll-mt-20 bg-white dark:bg-navy-950 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="w-full order-last lg:order-none">
        <video class="rounded-xl shadow-xl w-full dark:hidden" autoplay loop muted playsinline preload="metadata" poster="/images/feature-quick-log.png" width="1200" height="675" aria-label="NinerLog Quick Log screen mid-session, showing off-block and takeoff already tapped and awaiting landing">
          <source src="/images/demo-quicklog.webm" type="video/webm" />
          <img src="/images/feature-quick-log.png" alt="NinerLog Quick Log screen mid-session, showing off-block and takeoff already tapped and awaiting landing" class="w-full" loading="lazy" width="1200" height="675" />
        </video>
        <video class="rounded-xl shadow-xl w-full hidden dark:block" autoplay loop muted playsinline preload="metadata" poster="/images/feature-quick-log-dark.png" width="1200" height="675" aria-label="NinerLog Quick Log screen mid-session, showing off-block and takeoff already tapped and awaiting landing">
          <source src="/images/demo-quicklog-dark.webm" type="video/webm" />
          <img src="/images/feature-quick-log-dark.png" alt="NinerLog Quick Log screen mid-session, showing off-block and takeoff already tapped and awaiting landing" class="w-full" loading="lazy" width="1200" height="675" />
        </video>
      </div>
      <div class="reveal">
        {{ badge("QUICK LOG &bull; LIVE BLOCK TIMES") }}
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4 mt-3">Your logbook runs while you fly</h2>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Open Quick Log on your phone, pick your aircraft, and tap once at each milestone &mdash; off block, takeoff, landing, on block. The moment you go on blocks, those taps become a complete entry: block times, total time, route, all filled in. No watch-glancing, no kneeboard scribbles to decipher later.
        </p>
        <ul class="space-y-3">
          {{ check("<strong>One tap per event.</strong> Off-block, takeoff, landing and on-block, captured the second they happen") }}
          {{ check("<strong>The flight logs itself.</strong> Going on blocks writes the entry &mdash; review it, add landings, crew or remarks, done") }}
          {{ check("<strong>GPS airport detection.</strong> Grant location access and your departure and arrival airports fill themselves in") }}
          {{ check("<strong>Works offline.</strong> No signal at the airfield? Taps are saved on your device and sync when you&rsquo;re back") }}
          {{ check("<strong>Add aircraft on the spot.</strong> Flying something new? Quick-add its registration and type without leaving the screen") }}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- 1b — What the flight form works out for you -->
<section class="bg-slate-50 dark:bg-navy-900 py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mb-10 lg:mb-14 reveal">
      {{ badge("AUTO-CALCULATED") }}
      <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-slate-800 dark:text-white mb-4 mt-3">The columns nobody enjoys filling in</h2>
      <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
        A paper logbook makes you work out night time, cross-country and distance yourself, then hope you got it right. NinerLog derives them from what you already entered &mdash; and you can always override any of it.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal reveal-delay-1">
      {{ card("Night time, properly", "Worked out from your actual off-block and on-block times against real sunset and sunrise at your departure and arrival airports &mdash; not a guess, and not the whole flight rounded to night.") }}
      {{ card("Day and night landings", "Split automatically from the time of arrival, along with day and night takeoffs. Override either when the sky disagrees with the almanac.") }}
      {{ card("Cross-country and distance", "Cross-country time when departure and arrival differ; great-circle distance in nautical miles from the airport coordinates.") }}
      {{ card("Roles, from the crew list", "PIC, dual, solo, SIC, dual given and multi-pilot time all follow from who was on board and in which seat &mdash; you tick the role, not the stopwatch.") }}
      {{ card("Simulator sessions kept apart", "An FSTD session records its own duration and FSTD type (FNPT II, FFS, BATD&hellip;) and is never summed into flight time, exactly as AMC1 FCL.050 requires.", true) }}
      {{ card("Legs where you were a passenger", "Riding along rather than crewing? The row keeps the route and block times as the record of the trip and counts toward no total, statistic or currency.", true) }}
      {{ card("IFR, done in detail", "Actual and simulated instrument time, holds, and each approach recorded with its type, airport and runway &mdash; the structure FAA &sect;61.51(g)(3) asks for.") }}
      {{ card("Fields with no ICAO code", "Landing on a farm strip, a glacier, or a field that never got a code? Type the place name. It stays as written and the flight still counts.", true) }}
      {{ card("And it can do it all again", "Fixed an aircraft&rsquo;s class, or corrected an airport years after the fact? One recalculation pass re-derives the computed fields across your whole logbook.") }}
    </div>
  </div>
</section>

<!-- ============================================================
     2 — SEARCH
