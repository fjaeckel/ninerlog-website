{% set pageTitle = "Page Not Found — NinerLog" %}
{% set pageDescription = "Looks like you've gone off course. Head back to the NinerLog homepage." %}
{% set pagePath = "/404" %}
{% extends "layouts/base.njk" %}

{% block content %}

<section class="bg-gradient-to-br from-navy-900 via-navy-800 to-navy-950 min-h-[70vh] flex flex-col items-center justify-center py-16">
  <div class="text-center px-4">
    <!-- Tilted plane icon -->
    <svg class="w-16 h-16 text-sky-400 mx-auto mb-6 -rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>

    <h1 class="text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
      Looks like you&rsquo;ve gone off course.
    </h1>
    <p class="text-lg text-slate-300 mb-8 max-w-md mx-auto">
      The page you&rsquo;re looking for doesn&rsquo;t exist or has been moved.
    </p>

    <a href="/"
       class="inline-flex items-center gap-2 px-6 py-3 border border-white/20 text-white rounded-full hover:bg-white/10 hover:border-white/30 transition-all duration-200 font-semibold">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      Back to Home
    </a>

    <p class="mt-8 text-sm text-slate-500">404 &bull; Lost in the pattern</p>
  </div>
</section>

{% endblock %}
