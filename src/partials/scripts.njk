{#
  Ridiculytics — cookieless analytics, collector at stats.ninerlog.com.

  Pinned to an exact version rather than the @1 range the upstream README
  suggests: SRI hashes a specific build, so a floating range would break the
  page the moment 1.0.2 ships. Bumping the version means recomputing
  `integrity` — see docs in the PR that introduced this.

  The collector's site allowlist covers ninerlog.com and www.ninerlog.com;
  events from any other origin are rejected server-side.
#}
<script defer
        src="https://cdn.jsdelivr.net/npm/ridiculytics@1.0.1/web/counter.min.js"
        integrity="sha384-uNCU8e2RB7Yn6lVNut2gupQsJwKwXPZu2i4t/Eg6Q59ki0kchBR4L4yoS3ZxxjEX"
        crossorigin="anonymous"
        referrerpolicy="no-referrer"
        data-host="https://stats.ninerlog.com"
        data-site="ninerlog.com"></script>

<!-- Mobile menu JS -->
<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const closeBtn = document.getElementById('menu-close');

  function openMenu() {
    menu.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    menu.classList.add('hidden');
    document.body.style.overflow = '';
  }

  if (toggle) toggle.addEventListener('click', openMenu);
  if (closeBtn) closeBtn.addEventListener('click', closeMenu);
  if (menu) {
    menu.querySelectorAll('a').forEach(function(a) {
      a.addEventListener('click', closeMenu);
    });
  }
</script>

<!-- Appearance toggle -->
<script>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;

    var order = ['system', 'light', 'dark'];
    var labels = JSON.parse(btn.getAttribute('data-theme-labels'));
    var media = window.matchMedia('(prefers-color-scheme: dark)');
    var root = document.documentElement;

    function read() {
      try { return localStorage.getItem('theme') || 'system'; } catch (e) { return 'system'; }
    }

    function apply(mode) {
      root.classList.toggle('dark', mode === 'dark' || (mode === 'system' && media.matches));
      root.dataset.themeMode = mode;
      btn.setAttribute('aria-label', labels[mode]);
      btn.setAttribute('title', labels[mode]);
    }

    btn.addEventListener('click', function () {
      var next = order[(order.indexOf(read()) + 1) % order.length];
      // "system" is the absence of a choice, so it is stored as no key at all.
      try {
        if (next === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', next);
      } catch (e) { /* private mode: the choice lasts for this page only */ }
      apply(next);
    });

    media.addEventListener('change', function () {
      if (read() === 'system') apply('system');
    });

    apply(read());
  })();
</script>

<!-- Language picker dropdown -->
<script>
  (function() {
    var picker = document.getElementById('lang-picker');
    var langToggle = document.getElementById('lang-toggle');
    var langMenu = document.getElementById('lang-menu');
    if (!picker || !langToggle || !langMenu) return;

    function setOpen(open) {
      langMenu.classList.toggle('hidden', !open);
      langToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    langToggle.addEventListener('click', function(e) {
      e.stopPropagation();
      setOpen(langMenu.classList.contains('hidden'));
    });

    document.addEventListener('click', function(e) {
      if (!picker.contains(e.target)) setOpen(false);
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !langMenu.classList.contains('hidden')) {
        setOpen(false);
        langToggle.focus();
      }
    });
  })();
</script>

<!-- Copy-to-clipboard for code blocks -->
<script>
  document.querySelectorAll('[data-copy]').forEach(function(btn) {
    var label = btn.querySelector('.copy-label');
    var defaultText = label ? label.textContent : '';
    var copiedText = btn.getAttribute('data-copied-label') || defaultText;
    btn.addEventListener('click', function() {
      if (!navigator.clipboard) return;
      navigator.clipboard.writeText(btn.getAttribute('data-copy')).then(function() {
        btn.classList.add('copied');
        if (label) label.textContent = copiedText;
        clearTimeout(btn._copyTimeout);
        btn._copyTimeout = setTimeout(function() {
          btn.classList.remove('copied');
          if (label) label.textContent = defaultText;
        }, 1800);
      });
    });
  });
</script>

<!-- "Ask an AI" — copy the prompt on the way to the assistant -->
<script>
  document.querySelectorAll('[data-ask-ai-group]').forEach(function(group) {
    var prompt = group.getAttribute('data-ask-ai-prompt');
    var status = group.querySelector('[data-ask-ai-status]');
    if (!prompt) return;

    group.querySelectorAll('[data-ask-ai]').forEach(function(link) {
      // No preventDefault: the anchor still opens the assistant, and the copy
      // rides along on the same user gesture. Only two of the four providers
      // accept a prompt in the URL, so the clipboard covers the rest.
      link.addEventListener('click', function() {
        if (!navigator.clipboard) return;
        navigator.clipboard.writeText(prompt).then(function() {
          if (status) status.classList.remove('hidden');
        }).catch(function() {});
      });
    });
  });
</script>

<!-- Scroll reveal IntersectionObserver -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.reveal').forEach(function(el) {
      observer.observe(el);
    });
  });
</script>
