{#
  Nav links and labels per language. German pages link to their German
  counterparts; only pages that actually exist in a language are listed.
#}
{% if pageLang == "de" %}
  {% set navLinks = [
    { href: "/de/funktionen", label: "Funktionen" },
    { href: "/de/selbst-hosten", label: "Selbst hosten" },
    { href: "/de/open-source-flugbuch", label: "Open Source" },
    { href: "/de/unterstuetzen", label: "Unterstützen" }
  ] %}
  {% set ctaLabel = "Kostenlos starten &rarr;" %}
  {% set ctaLabelMobile = "Kostenlos loslegen" %}
  {# altEn set = a real translation pair, so the switch may claim hreflang.
     Without one it still points at the EN home, but makes no equivalence claim. #}
  {% set enHref = altEn | default("/") %}
  {% set enIsPair = altEn %}
  {% set deHref = pagePath %}
  {% set deIsPair = true %}
  {% set langPickerLabel = "Sprache wählen" %}
  {% set openMenuLabel = "Menü öffnen" %}
  {% set closeMenuLabel = "Menü schließen" %}
  {% set navAriaLabel = "Hauptnavigation" %}
{% else %}
  {% set navLinks = [
    { href: "/features", label: "Features" },
    { href: "/self-hosted", label: "Self-Hosted" },
    { href: "/open-source", label: "Open Source" },
    { href: "/about", label: "About" },
    { href: "/donate", label: "Donate" }
  ] %}
  {% set ctaLabel = "Start Free &rarr;" %}
  {% set ctaLabelMobile = "Start Logging &mdash; It&rsquo;s Free" %}
  {% set enHref = pagePath %}
  {% set enIsPair = true %}
  {% set deHref = altDe | default("/de/flugbuch") %}
  {% set deIsPair = altDe %}
  {% set langPickerLabel = "Choose language" %}
  {% set openMenuLabel = "Open menu" %}
  {% set closeMenuLabel = "Close menu" %}
  {% set navAriaLabel = "Main navigation" %}
{% endif %}

<!-- Sticky Navigation Header -->
<header class="sticky top-0 z-50 bg-navy-900/95 backdrop-blur-xs border-b border-white/5">
  <nav class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between" aria-label="{{ navAriaLabel }}">
    <!-- Logo / Wordmark with N9 mark -->
    <a href="{{ '/de/flugbuch' if pageLang == 'de' else '/' }}" class="flex items-center gap-2 text-xl font-bold text-white font-display group">
      <span class="inline-flex items-center justify-center w-7 h-7 rounded-sm bg-sky-500/15 text-sky-400 text-xs font-mono font-bold group-hover:bg-sky-500/25 transition-colors">N9</span>
      <span><span class="text-white">Niner</span><span class="text-sky-400">Log</span></span>
    </a>

    <div class="flex items-center gap-2 lg:gap-6">
      <!-- Desktop nav -->
      <div class="hidden lg:flex items-center gap-6">
        {% for link in navLinks %}
        <a href="{{ link.href }}" class="text-sm text-slate-300 hover:text-white transition-colors">{{ link.label }}</a>
        {% endfor %}
        <a href="https://app.ninerlog.com/register"
           class="px-5 py-2 bg-amber-400 text-navy-900 text-sm font-semibold rounded-full hover:bg-amber-300 transition-colors">
          {{ ctaLabel | safe }}
        </a>
      </div>

      {#
        Language picker. Always present, at every breakpoint — a pilot landing on
        the wrong language should never have to hunt for the way out. Each entry
        links to this page's counterpart where one exists, and otherwise to that
        language's home; only a genuine counterpart carries hreflang.
      #}
      <div class="relative" id="lang-picker">
        <button type="button" id="lang-toggle"
                class="flex items-center gap-1.5 px-2 py-1.5 text-slate-300 hover:text-white border border-white/15 rounded-sm hover:border-white/30 transition-colors"
                aria-haspopup="true" aria-expanded="false" aria-label="{{ langPickerLabel }}">
          <span class="text-base leading-none" aria-hidden="true">{{ "🇩🇪" if pageLang == "de" else "🇬🇧" }}</span>
          <span class="text-xs font-mono font-bold">{{ "DE" if pageLang == "de" else "EN" }}</span>
          <svg class="w-3 h-3 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <ul id="lang-menu"
            class="hidden absolute right-0 mt-2 min-w-[9rem] py-1 bg-navy-800 border border-white/10 rounded-lg shadow-xl shadow-black/30 z-50">
          <li>
            <a href="{{ enHref }}"{% if enIsPair %} hreflang="en"{% endif %}{% if pageLang != "de" %} aria-current="true"{% endif %}
               class="flex items-center gap-2.5 px-3 py-2 text-sm {{ 'text-white bg-white/5' if pageLang != 'de' else 'text-slate-300' }} hover:bg-white/10 hover:text-white transition-colors">
              <span class="text-base leading-none" aria-hidden="true">🇬🇧</span>
              English
            </a>
          </li>
          <li>
            <a href="{{ deHref }}"{% if deIsPair %} hreflang="de"{% endif %}{% if pageLang == "de" %} aria-current="true"{% endif %}
               class="flex items-center gap-2.5 px-3 py-2 text-sm {{ 'text-white bg-white/5' if pageLang == 'de' else 'text-slate-300' }} hover:bg-white/10 hover:text-white transition-colors">
              <span class="text-base leading-none" aria-hidden="true">🇩🇪</span>
              Deutsch
            </a>
          </li>
        </ul>
      </div>

      <!-- Mobile hamburger -->
      <button id="menu-toggle" class="lg:hidden p-2 text-slate-300 hover:text-white" aria-label="{{ openMenuLabel }}">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile menu overlay -->
<div id="mobile-menu" class="hidden fixed inset-0 z-60 bg-navy-900/98 backdrop-blur-xs lg:hidden">
  <div class="flex flex-col items-center justify-center h-full gap-8">
    <button id="menu-close" class="absolute top-4 right-4 p-2 text-white" aria-label="{{ closeMenuLabel }}">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
    {% for link in navLinks %}
    <a href="{{ link.href }}" class="text-2xl text-white font-semibold hover:text-sky-400 transition-colors">{{ link.label }}</a>
    {% endfor %}
    <a href="https://app.ninerlog.com/register"
       class="mt-4 px-8 py-4 bg-amber-400 text-navy-900 font-semibold text-lg rounded-full hover:bg-amber-300 transition-colors">
      {{ ctaLabelMobile | safe }}
    </a>
  </div>
</div>
