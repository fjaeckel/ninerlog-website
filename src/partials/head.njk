<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ pageTitle | default("NinerLog — Your Logbook, Your Data, Forever Free") }}</title>
<meta name="description" content="{{ pageDescription | default("Free, open-source pilot logbook for GA pilots. Log flights, track currency, manage licenses. EASA & FAA compliant. No subscriptions.") }}" />
<link rel="canonical" href="https://ninerlog.com{{ pagePath | default('/') }}" />

{#
  hreflang — emitted only when a page has a genuine counterpart in the other
  language. English pages declare `altDe`, German pages declare `altEn`.
  Pages without a real translated equivalent deliberately emit nothing:
  hreflang must be reciprocal and point at actual equivalents.
#}
{% if altDe %}
{% set enUrl = "https://ninerlog.com" + (pagePath | default('/')) %}
{% set deUrl = "https://ninerlog.com" + altDe %}
{% elif altEn %}
{% set enUrl = "https://ninerlog.com" + altEn %}
{% set deUrl = "https://ninerlog.com" + (pagePath | default('/')) %}
{% endif %}
{% if enUrl and deUrl %}
<!-- Language alternates -->
<link rel="alternate" hreflang="en" href="{{ enUrl }}" />
<link rel="alternate" hreflang="de" href="{{ deUrl }}" />
<link rel="alternate" hreflang="x-default" href="{{ enUrl }}" />
{% endif %}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content="{{ pageTitle | default('NinerLog — Your Logbook, Your Data, Forever Free') }}" />
<meta property="og:description" content="{{ pageDescription | default('Free, open-source pilot logbook for GA pilots. Log flights, track currency, manage licenses. EASA & FAA compliant. No subscriptions.') }}" />
<meta property="og:image" content="https://ninerlog.com/images/og-image.png" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="670" />
<meta property="og:image:alt" content="NinerLog — free, open-source pilot logbook" />
<meta property="og:url" content="https://ninerlog.com{{ pagePath | default('/') }}" />
<meta property="og:site_name" content="NinerLog" />
<meta property="og:locale" content="{{ 'de_DE' if pageLang == 'de' else 'en_US' }}" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ pageTitle | default('NinerLog') }}" />
<meta name="twitter:description" content="{{ pageDescription | default('Free, open-source pilot logbook for GA pilots.') }}" />
<meta name="twitter:image" content="https://ninerlog.com/images/og-image.png" />
<meta name="twitter:image:alt" content="NinerLog — free, open-source pilot logbook" />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32 16x16" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!--
  Fonts are self-hosted (@font-face lives in styles.css). Preload the two faces
  used above the fold so they start downloading alongside the stylesheet rather
  than after it parses. JetBrains Mono is deliberately not preloaded — it only
  renders small badges and labels further down the page.
-->
<link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin-wght-normal.woff2" crossorigin />
<link rel="preload" as="font" type="font/woff2" href="/fonts/plus-jakarta-sans-latin-wght-normal.woff2" crossorigin />

<!-- Styles -->
<link rel="stylesheet" href="/styles.css" />

<!-- Structured Data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "NinerLog",
  "url": "https://ninerlog.com",
  "description": "Free, open-source pilot logbook for GA pilots. EASA and FAA compliant."
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "NinerLog",
  "operatingSystem": "Web",
  "applicationCategory": "UtilitiesApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Free, open-source digital pilot logbook with multi-license support, currency tracking, and EASA/FAA compliance."
}
</script>
