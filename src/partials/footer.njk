{% if pageLang == "de" %}
  {% set footTagline = "Das quelloffene Flugbuch für Piloten. Deine Daten, deine Regeln, kostenlos nutzbar." %}
  {% set footProductHeading = "Produkt" %}
  {% set footProductLinks = [
    { href: "/de/flugbuch", label: "Digitales Flugbuch" },
    { href: "/de/funktionen", label: "Funktionen" },
    { href: "/de/selbst-hosten", label: "Selbst hosten" },
    { href: "https://app.ninerlog.com", label: "Zur App" }
  ] %}
  {% set footResourcesHeading = "Mehr" %}
  {% set footResourcesLinks = [
    { href: "/de/open-source-flugbuch", label: "Open Source" },
    { href: "/about", label: "Über NinerLog (EN)" },
    { href: "/de/import-export", label: "Import & Export" },
    { href: "/de/fehler-melden", label: "Fehler melden" },
    { href: "/de/unterstuetzen", label: "Projekt unterstützen" }
  ] %}
  {% set footLegalHeading = "Rechtliches" %}
  {% set footCopy = "&copy; 2026 NinerLog. Open Source unter AGPL-3.0 &amp; MIT." %}
  {% set footMadeBy = "Von Piloten für Piloten." %}
{% else %}
  {% set footTagline = "The open-source pilot logbook. Your data, your rules, free to use." %}
  {% set footProductHeading = "Product" %}
  {% set footProductLinks = [
    { href: "/features", label: "Features" },
    { href: "/self-hosted", label: "Self-Hosted" },
    { href: "https://app.ninerlog.com", label: "Launch App" }
  ] %}
  {% set footResourcesHeading = "Resources" %}
  {% set footResourcesLinks = [
    { href: "/open-source", label: "Open Source" },
    { href: "/about", label: "About" },
    { href: "/report-a-bug", label: "Report a Bug" },
    { href: "/donate", label: "Support the Project" },
    { href: "https://github.com/fjaeckel/ninerlog-api/blob/main/api-spec/openapi.yaml", label: "API Docs" }
  ] %}
  {% set footLegalHeading = "Legal" %}
  {% set footCopy = "&copy; 2026 NinerLog. Open source under AGPL-3.0 &amp; MIT." %}
  {% set footMadeBy = "Made with <span class=\"text-rose-400\">&hearts;</span> by pilots, for pilots." %}
{% endif %}

<!-- Footer -->
<footer class="bg-navy-950 border-t border-white/5">
  <!-- Runway centerline divider at top -->
  <div class="pt-1" aria-hidden="true">
    <div class="runway-divider mx-auto"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">

      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href="{{ '/de/flugbuch' if pageLang == 'de' else '/' }}" class="flex items-center gap-2 text-xl font-bold text-white font-display">
          <span class="inline-flex items-center justify-center w-7 h-7 rounded-sm bg-sky-500/15 text-sky-400 text-xs font-mono font-bold">N9</span>
          <span><span>Niner</span><span class="text-sky-400">Log</span></span>
        </a>
        <p class="mt-3 text-sm text-slate-400 max-w-xs">
          {{ footTagline }}
        </p>
        <div class="flex gap-4 mt-4">
          <a href="https://github.com/fjaeckel/ninerlog" class="text-slate-400 hover:text-white transition-colors" aria-label="GitHub">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>

        {% include "partials/ask-ai.njk" %}
      </div>

      <!-- Product -->
      <div>
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">{{ footProductHeading }}</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          {% for link in footProductLinks %}
          <li><a href="{{ link.href }}" class="hover:text-white transition-colors">{{ link.label }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">{{ footResourcesHeading }}</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          {% for link in footResourcesLinks %}
          <li><a href="{{ link.href }}" class="hover:text-white transition-colors">{{ link.label }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">{{ footLegalHeading }}</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="/privacy" class="hover:text-white transition-colors">Datenschutz / Privacy</a></li>
          <li><a href="/terms" class="hover:text-white transition-colors">Terms of Service</a></li>
          <li><a href="/imprint" class="hover:text-white transition-colors">Impressum</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-white/5 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-slate-400">{{ footCopy | safe }}</p>
      <p class="text-xs text-slate-400 font-mono tracking-wide">{{ footMadeBy | safe }}</p>
    </div>
  </div>
</footer>
