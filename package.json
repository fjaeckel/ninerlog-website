{
  "name": "ninerlog-website",
  "version": "1.0.0",
  "private": true,
  "description": "NinerLog.com — The free, open-source pilot logbook website",
  "scripts": {
    "dev": "npm run build:fonts && concurrently \"npm:dev:*\"",
    "dev:njk": "nunjucks 'pages/**/*.njk' -p src -o _site -w",
    "dev:css": "tailwindcss -i src/input.css -o _site/styles.css --watch",
    "dev:serve": "npx serve _site -l 8080",
    "build": "npm run build:njk && npm run build:css && npm run build:assets && npm run build:fonts && npm run build:cachebust",
    "build:njk": "nunjucks 'pages/**/*.njk' -p src -o _site && cp -R _site/pages/. _site/ && rm -rf _site/pages",
    "build:css": "tailwindcss -i src/input.css -o _site/styles.css --minify",
    "build:assets": "cp -r images _site/ 2>/dev/null || true && cp favicon.svg favicon.ico apple-touch-icon.png robots.txt sitemap.xml CNAME b800d4dc908c442cbb0ef2112f93e191.txt _site/ 2>/dev/null || true",
    "build:fonts": "mkdir -p _site/fonts && cp node_modules/@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2 node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2 node_modules/@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2 _site/fonts/",
    "build:cachebust": "HASH=$(shasum -a 256 _site/styles.css | cut -c1-10) && find _site -name '*.html' -exec perl -i -pe \"s|/styles\\.css(?![\\?\\w])|/styles.css?v=$HASH|g\" {} +"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "nunjucks-cli": "^1.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
